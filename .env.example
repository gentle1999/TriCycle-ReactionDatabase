POSTGRES_DB=example_reaction_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example-local-password
POSTGRES_PORT=5432
# Keep loopback for a single-host development stack. On the data host in a
# two-host deployment, use its private address (or 0.0.0.0 with a firewall).
POSTGRES_BIND_ADDRESS=127.0.0.1
COMPOSE_PROJECT_NAME=reaction-database-development

# Complete container stack. Caddy automatically obtains and renews the TLS
# certificate for CADDY_SERVER_NAME. localhost uses Caddy's internal CA.
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_SERVER_NAME=localhost
# Compose defaults to the in-network services. A production edge may set these
# to one or more space-separated upstream addresses.
CADDY_API_UPSTREAM=api:8000
CADDY_FRONTEND_UPSTREAM=frontend:8080
# Production requires a public DNS name resolving to this host and ports 80/443
# reachable by the ACME issuer. Persist caddy-data; do not replace it per deploy.

# Container-only endpoints. Keep the ordinary TRICYCLE_* URLs below for
# host-based development; Compose maps these values into the API container.
TRICYCLE_COMPOSE_DATABASE_URL=postgresql+psycopg://example_user:example-local-password@postgres:5432/example_reaction_db
TRICYCLE_COMPOSE_RUSTFS_ENDPOINT_URL=http://rustfs:9000
# Only used with compose.compute.yaml. Bind-mount this host directory read-only
# into api/migrate/bootstrap; put internal-ca.pem there when private TLS is used.
# TRICYCLE_COMPOSE_CA_DIRECTORY=/etc/reaction-database/ca
TRICYCLE_BOOTSTRAP_MODE=development

RUSTFS_API_PORT=19000
RUSTFS_CONSOLE_PORT=19001
# Keep loopback for development. The data host may bind the S3 API to its
# private address so the compute host can reach it; keep the console restricted
# to the management network.
RUSTFS_BIND_ADDRESS=127.0.0.1
RUSTFS_CONSOLE_BIND_ADDRESS=127.0.0.1
# RustFS beta.8 transparently compresses eligible object data on disk.
RUSTFS_COMPRESSION_ENABLED=true

TRICYCLE_ENVIRONMENT=development
TRICYCLE_APP_NAME=Example Chemistry Database
TRICYCLE_BRAND_NAME=Example Research Platform
TRICYCLE_MCP_SERVER_NAME=Example Chemistry Database MCP
TRICYCLE_NEXUSX_APP_NAME=example-chemistry-database
TRICYCLE_NEXUSX_PLAYGROUND_NAME=example-chemistry-database-playground
TRICYCLE_NEXUSX_DATABASE_CLUSTER_NAME=example-chemistry-postgresql
TRICYCLE_NEXUSX_DATABASE_CLUSTER_COLOR="#E3F2FD"
TRICYCLE_DEBUG=false
TRICYCLE_API_HOST=0.0.0.0
TRICYCLE_API_PORT=8000
TRICYCLE_MAX_UPLOAD_BYTES=67108864
TRICYCLE_MAX_BATCH_FILES=64
TRICYCLE_MAX_BATCH_BYTES=536870912
TRICYCLE_MAX_UPLOAD_QUEUE_FILES=20000
TRICYCLE_MAX_UPLOAD_QUEUE_BYTES=1099511627776
TRICYCLE_MAX_UPLOAD_METADATA_BYTES=16384
# Keep parser concurrency bounded; a development-only -1 override is possible.
# These variables limit native OpenMP/BLAS threads inside each file worker;
# TRICYCLE_MOLOP_BATCH_N_JOBS limits concurrently running file workers.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TRICYCLE_MOLOP_BATCH_N_JOBS=2
# Baseline budget for a 10 MiB file; larger files scale proportionally.
TRICYCLE_MOLOP_FILE_PARSE_TIMEOUT_SECONDS=60
# MolOP 0.2.11 collects frame roles/source locators without implicit graph
# reconstruction, so keep evidence enabled for correct frame-role ingestion.
TRICYCLE_MOLOP_CAPTURE_SOURCE_EVIDENCE=true
TRICYCLE_MOLOP_PARALLEL_FRAME_PERSISTENCE=true
TRICYCLE_DATABASE_URL=postgresql+psycopg://example_user:example-local-password@127.0.0.1:5432/example_reaction_db
TRICYCLE_QUERY_STATEMENT_TIMEOUT_MS=15000
TRICYCLE_SLOW_QUERY_THRESHOLD_MS=500
TRICYCLE_GRAPHQL_MAX_QUERY_CHARACTERS=20000
TRICYCLE_GRAPHQL_MAX_TOKENS=2000
TRICYCLE_GRAPHQL_MAX_DEPTH=12
TRICYCLE_GRAPHQL_MAX_COMPLEXITY=250
TRICYCLE_QUERY_RATE_LIMIT_REQUESTS=120
TRICYCLE_READ_RATE_LIMIT_REQUESTS=10000
TRICYCLE_UPLOAD_RATE_LIMIT_REQUESTS=1000
TRICYCLE_UPLOAD_MAX_CONCURRENCY=8
TRICYCLE_MOLECULE_QUERY_RATE_LIMIT_REQUESTS=10000
TRICYCLE_DEPICTION_RATE_LIMIT_REQUESTS=10000
TRICYCLE_QUERY_RATE_LIMIT_WINDOW_SECONDS=60
# Production uses Redis so all API and MCP workers share one atomic request budget.
TRICYCLE_RATE_LIMIT_BACKEND=memory
# TRICYCLE_RATE_LIMIT_REDIS_URL=rediss://:<password>@redis-rw.internal.example:6380/0?ssl_ca_certs=/etc/reaction-database/ca/internal-ca.pem
TRICYCLE_RATE_LIMIT_KEY_PREFIX=reaction-database
TRICYCLE_STRUCTURE_QUERY_MAX_CHARACTERS=16384
TRICYCLE_STRUCTURE_CANDIDATE_LIMIT=50000
TRICYCLE_AUTH_MODE=development
# MCP 外部客户端令牌默认有效一年，生产环境可按轮换策略缩短。
TRICYCLE_MCP_TOKEN_TTL_SECONDS=31536000
TRICYCLE_SESSION_COOKIE_NAME=example_session
TRICYCLE_CSRF_COOKIE_NAME=example_csrf
TRICYCLE_CSRF_HEADER_NAME=x-csrf-token
TRICYCLE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]
# Invitations use a copyable link in development. Production should use SMTP.
TRICYCLE_EMAIL_DELIVERY_MODE=link
# TRICYCLE_SMTP_HOST=smtp.example.com
# TRICYCLE_SMTP_PORT=587
# TRICYCLE_SMTP_USERNAME=mailer@example.com
# TRICYCLE_SMTP_PASSWORD=replace-with-a-secret
# TRICYCLE_SMTP_FROM_EMAIL=mailer@example.com
# TRICYCLE_SMTP_STARTTLS=true
# Optional absolute PEM bundle for an internal SMTP relay CA.
# TRICYCLE_SMTP_CA_BUNDLE=/etc/reaction-database/ca/internal-ca.pem
# TRICYCLE_SMTP_TIMEOUT_SECONDS=15
# Production OIDC settings:
# TRICYCLE_ENVIRONMENT=production
# TRICYCLE_AUTH_MODE=oidc
# TRICYCLE_SESSION_SECRET=replace-with-a-unique-32-plus-character-secret
# TRICYCLE_SESSION_COOKIE_SECURE=true
# TRICYCLE_DATABASE_URL=postgresql+psycopg://user:password@db-rw.internal.example/reactions?sslmode=verify-full
# TRICYCLE_CORS_ORIGINS=["https://app.example.com"]
# TRICYCLE_RATE_LIMIT_BACKEND=redis
# TRICYCLE_RATE_LIMIT_REDIS_URL=rediss://:<password>@redis-rw.internal.example:6380/0?ssl_ca_certs=/etc/reaction-database/ca/internal-ca.pem
# TRICYCLE_OIDC_ISSUER=https://identity.example.com/realms/example
# TRICYCLE_OIDC_AUDIENCE=example-chemistry-database
# TRICYCLE_OIDC_JWKS_URL=https://identity.example.com/realms/example/protocol/openid-connect/certs
# Optional absolute PEM bundle for an internal OIDC issuer CA.
# TRICYCLE_OIDC_CA_BUNDLE=/etc/reaction-database/ca/internal-ca.pem
# TRICYCLE_OIDC_CLIENT_ID=example-chemistry-database
# TRICYCLE_OIDC_CLIENT_SECRET=replace-with-provider-secret
# TRICYCLE_OIDC_REDIRECT_URI=https://app.example.com/api/auth/callback
# Required once, before `tricycle-bootstrap --mode production`:
# TRICYCLE_BOOTSTRAP_OIDC_ISSUER=https://identity.example.com/realms/example
# TRICYCLE_BOOTSTRAP_OIDC_SUBJECT=<initial-admin-sub-claim>
# TRICYCLE_BOOTSTRAP_ADMIN_DISPLAY_NAME=Database Administrator
# TRICYCLE_BOOTSTRAP_ADMIN_EMAIL=administrator@example.com
# TRICYCLE_BOOTSTRAP_ORGANIZATION_SLUG=example-lab
# TRICYCLE_BOOTSTRAP_ORGANIZATION_NAME=Example Lab
# TRICYCLE_BOOTSTRAP_PROJECT_SLUG=reaction-catalog
# TRICYCLE_BOOTSTRAP_PROJECT_NAME=Reaction Catalog
# Local Keycloak OIDC settings (enabled by the `compose.yaml` keycloak service):
# TRICYCLE_AUTH_MODE=oidc
# TRICYCLE_OIDC_ISSUER=http://127.0.0.1:8080/realms/example
# TRICYCLE_OIDC_AUDIENCE=example-chemistry-frontend
# TRICYCLE_OIDC_JWKS_URL=http://127.0.0.1:8080/realms/example/protocol/openid-connect/certs
# TRICYCLE_OIDC_CLIENT_ID=example-chemistry-frontend
# TRICYCLE_OIDC_CLIENT_SECRET=example-frontend-dev-secret
# TRICYCLE_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# TRICYCLE_OIDC_FRONTEND_URL=http://127.0.0.1:5173
# TRICYCLE_OIDC_BOOTSTRAP_SUBJECT=00000000-0000-0000-0000-000000000002
# TRICYCLE_OIDC_BOOTSTRAP_USER_ID=00000000-0000-7000-8000-000000000002
TRICYCLE_RUSTFS_ENDPOINT_URL=http://127.0.0.1:19000
TRICYCLE_RUSTFS_ACCESS_KEY=example-local-access
TRICYCLE_RUSTFS_SECRET_KEY=example-local-secret
TRICYCLE_RUSTFS_BUCKET=example-reaction-raw-files
TRICYCLE_RUSTFS_REGION=us-east-1
TRICYCLE_RUSTFS_VERIFY_TLS=true
# Private-CA deployments may set an absolute PEM bundle path.
# TRICYCLE_RUSTFS_CA_BUNDLE=/etc/reaction-database/ca/internal-ca.pem
# Production requires an https:// endpoint and TLS verification.
# Incremental RustFS GC; run `make storage-gc` from a scheduler.
TRICYCLE_STORAGE_GC_GRACE_PERIOD_SECONDS=3600
TRICYCLE_STORAGE_GC_INITIAL_LOOKBACK_SECONDS=86400
TRICYCLE_STORAGE_GC_PARTITION_CLOCK_SKEW_SECONDS=3600

# Frontend image build arguments. Keep the API base empty for same-origin HTTPS.
VITE_API_BASE_URL=
VITE_APP_NAME=Example Chemistry Database
VITE_BRAND_NAME=Example Research Platform
VITE_APP_TAGLINE=Computational data browser
VITE_MCP_SERVER_NAME=example-chemistry-database
VITE_CSRF_COOKIE_NAME=example_csrf
VITE_CSRF_HEADER_NAME=x-csrf-token
