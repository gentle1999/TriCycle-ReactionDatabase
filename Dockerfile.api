ARG PYTHON_BASE_IMAGE=python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134

FROM ${PYTHON_BASE_IMAGE} AS builder

ARG UV_VERSION=0.9.13
ARG PYPI_INDEX_URL=https://pypi.org/simple
ARG http_proxy
ARG https_proxy
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

RUN pip install --no-cache-dir --index-url "${PYPI_INDEX_URL}" "uv==${UV_VERSION}"

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --default-index "${PYPI_INDEX_URL}"

COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --default-index "${PYPI_INDEX_URL}"


FROM ${PYTHON_BASE_IMAGE} AS runtime

ARG DEBIAN_MIRROR=https://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=https://security.debian.org/debian-security

ENV HOME=/tmp \
    PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    XDG_CACHE_HOME=/tmp/.cache

RUN set -eux; \
    printf '%s\n' \
        'Types: deb' \
        "URIs: ${DEBIAN_MIRROR}" \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        '' \
        'Types: deb' \
        "URIs: ${DEBIAN_SECURITY_MIRROR}" \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        > /etc/apt/sources.list.d/debian.sources; \
    apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        libexpat1 \
        libgomp1 \
        libstdc++6 \
        libx11-6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 tricycle \
    && useradd --uid 10001 --gid tricycle --no-create-home --shell /usr/sbin/nologin tricycle

WORKDIR /app

COPY --from=builder --chown=tricycle:tricycle /app/.venv /app/.venv
COPY --chown=tricycle:tricycle alembic.ini ./alembic.ini
COPY --chown=tricycle:tricycle migrations ./migrations

WORKDIR /tmp

USER tricycle

EXPOSE 8000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/health/ready', timeout=4).read()"

CMD ["tricycle-api"]
