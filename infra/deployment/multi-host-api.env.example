# Production API-node EnvironmentFile example. The same non-secret values must
# be installed on every API node. Generate secret values from a secret manager;
# do not deploy the literal replace-* placeholders below.

TRICYCLE_ENVIRONMENT=production
TRICYCLE_DEBUG=false
TRICYCLE_API_HOST=0.0.0.0
TRICYCLE_API_PORT=8000

# Installation-owned display names and protocol keys.
TRICYCLE_APP_NAME="Example Chemistry Database"
TRICYCLE_BRAND_NAME="Example Research Platform"
TRICYCLE_MCP_SERVER_NAME="Example Chemistry Database MCP"
TRICYCLE_NEXUSX_APP_NAME=example-chemistry-database
TRICYCLE_NEXUSX_PLAYGROUND_NAME=example-chemistry-database-playground
TRICYCLE_NEXUSX_DATABASE_CLUSTER_NAME=example-chemistry-postgresql
TRICYCLE_NEXUSX_DATABASE_CLUSTER_COLOR="#E3F2FD"

# A stable read-write endpoint fronts the PostgreSQL/RDKit HA nodes.
TRICYCLE_DATABASE_URL=postgresql+psycopg://reaction_app:replace-with-url-encoded-password@db-rw.internal.example:5432/reactions?sslmode=verify-full&sslrootcert=/etc/reaction-database/ca/internal-ca.pem
TRICYCLE_QUERY_STATEMENT_TIMEOUT_MS=15000
TRICYCLE_SLOW_QUERY_THRESHOLD_MS=500

# A stable HTTPS S3 endpoint fronts all RustFS nodes.
TRICYCLE_RUSTFS_ENDPOINT_URL=https://s3.internal.example:9000
TRICYCLE_RUSTFS_ACCESS_KEY=replace-with-secret-manager-value
TRICYCLE_RUSTFS_SECRET_KEY=replace-with-secret-manager-value
TRICYCLE_RUSTFS_BUCKET=example-chemistry-raw-files
TRICYCLE_RUSTFS_REGION=us-east-1
TRICYCLE_RUSTFS_VERIFY_TLS=true
TRICYCLE_RUSTFS_CA_BUNDLE=/etc/reaction-database/ca/internal-ca.pem

# Redis.from_url consumes one stable writable endpoint. Put Sentinel/Cluster or
# managed Redis nodes behind that endpoint; do not list node addresses here.
TRICYCLE_RATE_LIMIT_BACKEND=redis
TRICYCLE_RATE_LIMIT_REDIS_URL=rediss://:replace-with-url-encoded-password@redis-rw.internal.example:6380/0?ssl_ca_certs=/etc/reaction-database/ca/internal-ca.pem
TRICYCLE_RATE_LIMIT_KEY_PREFIX=example-chemistry-database

# One issuer URL fronts all OIDC nodes and must remain unchanged during failover.
TRICYCLE_AUTH_MODE=oidc
TRICYCLE_OIDC_ISSUER=https://identity.example.org/realms/chemistry
TRICYCLE_OIDC_AUDIENCE=example-chemistry-database
TRICYCLE_OIDC_JWKS_URL=https://identity.example.org/realms/chemistry/protocol/openid-connect/certs
TRICYCLE_OIDC_CA_BUNDLE=/etc/reaction-database/ca/internal-ca.pem
TRICYCLE_OIDC_CLIENT_ID=example-chemistry-database
TRICYCLE_OIDC_CLIENT_SECRET=replace-with-secret-manager-value
TRICYCLE_OIDC_REDIRECT_URI=https://reactions.example.org/api/auth/callback
TRICYCLE_OIDC_FRONTEND_URL=https://reactions.example.org

TRICYCLE_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TRICYCLE_SESSION_COOKIE_NAME=example_chemistry_session
TRICYCLE_CSRF_COOKIE_NAME=example_chemistry_csrf
TRICYCLE_CSRF_HEADER_NAME=x-example-chemistry-csrf
TRICYCLE_SESSION_COOKIE_SECURE=true
TRICYCLE_CORS_ORIGINS=["https://reactions.example.org"]

# The relay DNS name may front several SMTP nodes.
TRICYCLE_EMAIL_DELIVERY_MODE=smtp
TRICYCLE_SMTP_HOST=smtp.internal.example
TRICYCLE_SMTP_PORT=587
TRICYCLE_SMTP_USERNAME=mailer@example.org
TRICYCLE_SMTP_PASSWORD=replace-with-secret-manager-value
TRICYCLE_SMTP_FROM_EMAIL=mailer@example.org
TRICYCLE_SMTP_STARTTLS=true
TRICYCLE_SMTP_CA_BUNDLE=/etc/reaction-database/ca/internal-ca.pem
TRICYCLE_SMTP_TIMEOUT_SECONDS=15

# Bound CPU and memory work per API process.
# Limit native OpenMP/BLAS pools inside each file worker. Concurrent file
# workers remain controlled separately by TRICYCLE_MOLOP_BATCH_N_JOBS.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TRICYCLE_MOLOP_PARSE_SLOTS=1
TRICYCLE_MOLOP_BATCH_N_JOBS=2
TRICYCLE_MOLOP_FILE_PARSE_TIMEOUT_SECONDS=60
TRICYCLE_MOLOP_CAPTURE_SOURCE_EVIDENCE=true
TRICYCLE_MOLOP_PARALLEL_FRAME_PERSISTENCE=true
