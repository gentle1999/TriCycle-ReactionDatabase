worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    access_log /dev/stdout;
    error_log /dev/stderr warn;
    sendfile on;
    keepalive_timeout 65;

    # The application enforces request budgets. Nginx only transports long
    # uploads and parsing responses without adding a second size/rate ceiling.
    client_max_body_size 0;
    client_body_timeout 3600s;
    send_timeout 3600s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    upstream reaction_database_api {
        least_conn;
        server api:8000 max_fails=3 fail_timeout=10s;
        keepalive 32;
    }

    upstream reaction_database_frontend {
        server frontend:8080 max_fails=3 fail_timeout=10s;
        keepalive 16;
    }

    server {
        listen 8080;
        server_name ${NGINX_SERVER_NAME};
        return 308 https://$host:${NGINX_PUBLIC_HTTPS_PORT}$request_uri;
    }

    server {
        listen 8443 ssl;
        http2 on;
        server_name ${NGINX_SERVER_NAME};

        ssl_certificate /etc/nginx/tls/tls.crt;
        ssl_certificate_key /etc/nginx/tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        include /etc/nginx/includes/api-locations.conf;

        location = /editor/chemdoodle-editor.html {
            proxy_pass http://reaction_database_frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;
        }

        location / {
            proxy_pass http://reaction_database_frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }
}
