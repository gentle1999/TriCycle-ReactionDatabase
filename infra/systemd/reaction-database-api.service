[Unit]
Description=Reaction database FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=reactiondb
Group=reactiondb
WorkingDirectory=/opt/reaction-database
EnvironmentFile=/etc/reaction-database/application.env
ExecStart=/opt/reaction-database/.venv/bin/tricycle-api
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=120s
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
