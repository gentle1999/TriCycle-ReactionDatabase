[Unit]
Description=Reaction database incremental RustFS garbage collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=reactiondb
Group=reactiondb
WorkingDirectory=/opt/reaction-database
EnvironmentFile=/etc/reaction-database/application.env
ExecStart=/opt/reaction-database/.venv/bin/tricycle-rustfs-gc
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LockPersonality=true
RestrictSUIDSGID=true

