# Copy to .env on the compute host. Use with:
# docker compose -f compose.yaml -f compose.compute.yaml up -d --build --wait
COMPOSE_PROJECT_NAME=reaction-database-compute

# Remote data-host endpoints. URL-encode reserved characters in passwords.
TRICYCLE_COMPOSE_DATABASE_URL=postgresql+psycopg://example_user:replace-with-a-strong-password@192.168.50.29:5433/example_reaction_db
TRICYCLE_COMPOSE_RUSTFS_ENDPOINT_URL=http://192.168.50.29:9001
# Host-run commands use the same resolved endpoints; Compose expands this.
TRICYCLE_DATABASE_URL=${TRICYCLE_COMPOSE_DATABASE_URL}
TRICYCLE_RUSTFS_ENDPOINT_URL=${TRICYCLE_COMPOSE_RUSTFS_ENDPOINT_URL}
TRICYCLE_RUSTFS_ACCESS_KEY=replace-with-an-access-key
TRICYCLE_RUSTFS_SECRET_KEY=replace-with-a-secret-key
TRICYCLE_RUSTFS_BUCKET=example-reaction-raw-files
TRICYCLE_RUSTFS_REGION=us-east-1
TRICYCLE_RUSTFS_VERIFY_TLS=false

# One uploaded batch uses the configured process-pool workers for file-level parsing.
TRICYCLE_MOLOP_BATCH_N_JOBS=-1

# Keep the first development run on the built-in fixed development identity.
# Keycloak is still started for local OIDC work; switch auth_mode after its
# issuer is reachable from both the browser and the API container.
TRICYCLE_ENVIRONMENT=development
TRICYCLE_AUTH_MODE=development
TRICYCLE_BOOTSTRAP_MODE=development
TRICYCLE_API_HOST=0.0.0.0
TRICYCLE_API_PORT=8000
TRICYCLE_SESSION_SECRET=development-session-secret-change-me

# Dify has been removed from this host, so the standard web ports are free.
NGINX_BIND_ADDRESS=10.66.0.18
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=localhost
NGINX_SELF_SIGNED_CERT_DAYS=30
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8080

# compose.compute.yaml mounts this directory read-only into API/migrate/
# bootstrap. Put internal-ca.pem here when the remote endpoints use a private
# CA; for plain HTTP/TCP development it may remain empty.
TRICYCLE_COMPOSE_CA_DIRECTORY=./secrets/ca
