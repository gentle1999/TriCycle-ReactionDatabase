# Copy to .env on the file server when using compose.data.yaml.
COMPOSE_PROJECT_NAME=reaction-database-data

POSTGRES_DB=example_reaction_db
POSTGRES_USER=example_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_BIND_ADDRESS=192.168.50.29
POSTGRES_PORT=5433
POSTGRES_DATA_DIRECTORY=/srv/reaction-database/postgres

# RustFS S3 API is reachable by the compute host. Keep the console on a
# management-only address (or 127.0.0.1 and use an SSH tunnel).
RUSTFS_BIND_ADDRESS=192.168.50.29
RUSTFS_API_PORT=9001
RUSTFS_CONSOLE_BIND_ADDRESS=127.0.0.1
RUSTFS_CONSOLE_PORT=9002
RUSTFS_DATA_DIRECTORY=/srv/reaction-database/rustfs
RUSTFS_LOG_DIRECTORY=/srv/reaction-database/rustfs-logs
TRICYCLE_RUSTFS_ACCESS_KEY=replace-with-an-access-key
TRICYCLE_RUSTFS_SECRET_KEY=replace-with-a-secret-key
RUSTFS_COMPRESSION_ENABLED=true

# Shared by the compute host when the same .env is copied there. Compose
# expands these references before injecting them into API/migrate/bootstrap.
# URL-encode the PostgreSQL password first if it contains @, :, /, # or %.
TRICYCLE_COMPOSE_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@192.168.50.29:${POSTGRES_PORT}/${POSTGRES_DB}
TRICYCLE_COMPOSE_RUSTFS_ENDPOINT_URL=http://192.168.50.29:${RUSTFS_API_PORT}
TRICYCLE_DATABASE_URL=${TRICYCLE_COMPOSE_DATABASE_URL}
TRICYCLE_RUSTFS_ENDPOINT_URL=${TRICYCLE_COMPOSE_RUSTFS_ENDPOINT_URL}
