# Leave empty when /api, /health and /docs are reverse-proxied on the same origin.
VITE_API_BASE_URL=

# Deployment-facing labels are build-time settings. Replace these defaults for
# each installation and rebuild frontend/dist.
VITE_APP_NAME=Example Chemistry Database
VITE_BRAND_NAME=Example Research Platform
VITE_APP_TAGLINE=计算数据浏览器
VITE_MCP_SERVER_NAME=example-chemistry-database

# Must match the backend values when deployment-specific cookie/header names are used.
VITE_CSRF_COOKIE_NAME=example_csrf
VITE_CSRF_HEADER_NAME=x-csrf-token

# Vite development proxy target. The backend defaults to port 8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional NexusX transport links. Local defaults use ports 8000/8001/8005-8008.
# VITE_NEXUSX_GRAPHQL_URL=http://127.0.0.1:8000/graphql
# VITE_NEXUSX_CORE_URL=http://127.0.0.1:8001/docs
# VITE_NEXUSX_PAGINATED_GRAPHQL_URL=http://127.0.0.1:8005/graphql
# VITE_NEXUSX_MCP_URL=http://127.0.0.1:8006/mcp
# VITE_NEXUSX_REST_URL=http://127.0.0.1:8007/docs
# VITE_NEXUSX_VOYAGER_URL=http://127.0.0.1:8008/voyager
