FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_BASE_URL=
ARG VITE_APP_NAME="Example Chemistry Database"
ARG VITE_BRAND_NAME="Example Research Platform"
ARG VITE_APP_TAGLINE="Computational data browser"
ARG VITE_MCP_SERVER_NAME=example-chemistry-database
ARG VITE_CSRF_COOKIE_NAME=example_csrf
ARG VITE_CSRF_HEADER_NAME=x-csrf-token

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_APP_NAME=${VITE_APP_NAME} \
    VITE_BRAND_NAME=${VITE_BRAND_NAME} \
    VITE_APP_TAGLINE=${VITE_APP_TAGLINE} \
    VITE_MCP_SERVER_NAME=${VITE_MCP_SERVER_NAME} \
    VITE_CSRF_COOKIE_NAME=${VITE_CSRF_COOKIE_NAME} \
    VITE_CSRF_HEADER_NAME=${VITE_CSRF_HEADER_NAME}

RUN npm run build


FROM nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236 AS runtime

COPY infra/frontend/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html

USER nginx

EXPOSE 8080
STOPSIGNAL SIGQUIT

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
