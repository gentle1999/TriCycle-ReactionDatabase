  "participants": [
    { "id": "remote", "type": "external", "label": "远程客户端", "sublabel": "单 / 批量" },
    { "id": "local", "type": "external", "label": "本地导入 CLI", "sublabel": "本地文件" },
    { "id": "ingress", "type": "backend", "label": "上传暂存服务", "sublabel": "暂存入口" },
    { "id": "rustfs", "type": "cloud", "label": "RustFS", "sublabel": "对象暂存" },
    { "id": "postgres", "type": "database", "label": "PostgreSQL", "sublabel": "队列与领域" },
    { "id": "worker", "type": "backend", "label": "upload-worker", "sublabel": "单实例" },
    { "id": "molop", "type": "backend", "label": "MolOP 进程池", "sublabel": "共享解析" },
    { "id": "committer", "type": "backend", "label": "持久化消费者", "sublabel": "微批提交" }
  ],
  "segments": [
    { "from": 150, "to": 540, "label": "统一暂存" },
    { "from": 548, "to": 710, "label": "领取任务" },
